{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@pku-harness/sdk": ["./packages/sdk/src/index.ts"],
      "@pku-harness/sdk/*": ["./packages/sdk/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "plugins/*/src/**/*.ts", "plugins/*/src/**/*.tsx", "plugins/*.ts", "scripts/**/*.ts", "registry/**/*.ts"]
}
