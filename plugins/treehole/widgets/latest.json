{
  "title": "树洞最新",
  "description": "北大树洞最新的 3 条帖子（大尺寸 5 条），点按打开。",
  "sizes": ["md", "lg"],
  "defaultSize": "md",
  "bindings": {
    "/feed": { "tool": "latest", "args": { "limit": 5 }, "ttlMinutes": 10 }
  },
  "strings": {
    "zh-Hans": { "replies": " 回复", "verify": "树洞需要短信验证", "goVerify": "去验证", "empty": "暂时没有新帖子" },
    "en": { "replies": " replies", "verify": "Treehole needs SMS verification", "goVerify": "Verify", "empty": "No new posts yet" }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": { "type": "Column", "props": { "gap": "sm" }, "children": ["list", "empty", "verify"] },
      "list": {
        "type": "Column",
        "props": { "gap": "sm" },
        "visible": { "$state": "/feed/status", "eq": "ok" },
        "repeat": { "statePath": "/feed/holes", "key": "pid" },
        "children": ["row"]
      },
      "row": {
        "type": "ListItem",
        "visible": { "$or": [{ "$index": true, "lt": 3 }, { "$state": "/size", "eq": "lg" }] },
        "props": {
          "title": { "$item": "text" },
          "subtitle": { "$template": "#${pid} · ${time} · ${replies}${/t/replies}" },
          "value": null,
          "icon": null
        },
        "on": { "press": { "action": "navigate", "params": { "href": { "$template": "/p/treehole/hole?pid=${pid}" } } } }
      },
      "empty": {
        "type": "Text",
        "props": { "text": { "$state": "/t/empty" }, "tone": "muted", "size": "small" },
        "visible": [{ "$state": "/feed/status", "eq": "ok" }, { "$state": "/feed/holes/0", "not": true }]
      },
      "verify": {
        "type": "Column",
        "props": { "gap": "sm" },
        "visible": { "$state": "/feed/status", "eq": "verification_required" },
        "children": ["verifyText", "verifyButton"]
      },
      "verifyText": { "type": "Text", "props": { "text": { "$state": "/t/verify" }, "tone": "muted", "size": "small" } },
      "verifyButton": {
        "type": "Button",
        "props": { "label": { "$state": "/t/goVerify" }, "variant": "secondary" },
        "on": { "press": { "action": "navigate", "params": { "href": "/p/treehole/home" } } }
      }
    },
    "state": { "feed": null }
  }
}
