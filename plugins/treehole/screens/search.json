{
  "title": "搜索：{q}",
  "description": "树洞搜索结果，一直往下滑就继续加载。打开方式：/p/treehole/search?q=…",
  "feed": true,
  "bindings": {
    "/res": {
      "tool": "search",
      "args": {
        "keyword": {
          "$param": "q"
        },
        "limit": 20
      },
      "ttlMinutes": 5
    }
  },
  "strings": {
    "zh-Hans": {
      "searchHint": "搜索树洞",
      "latest": "最新",
      "followed": "关注",
      "noMore": "没有更多了",
      "empty": "暂时没有新帖子",
      "noFollowed": "还没有关注的帖子",
      "loadFailed": "加载失败",
      "retry": "重试",
      "noResults": "没有找到相关的树洞",
      "smsNeeded": "需要短信验证",
      "verifyWhy": "树洞需要确认是你本人。点下面的按钮把验证码发到账号绑定的手机，允许读取这条短信后会自动填好；也可以手动输入。",
      "sendSms": "发送短信验证码",
      "smsCode": "短信验证码",
      "codePlaceholder": "6 位数字",
      "verify": "验证",
      "sent": "验证码已发送到绑定手机",
      "stillValid": "之前的验证码还有效，可以直接输入"
    },
    "en": {
      "searchHint": "Search Treehole",
      "latest": "Latest",
      "followed": "Following",
      "noMore": "That’s everything",
      "empty": "No new posts yet",
      "noFollowed": "You don’t follow any posts yet",
      "loadFailed": "Couldn’t load more",
      "retry": "Retry",
      "noResults": "No posts found",
      "smsNeeded": "SMS verification needed",
      "verifyWhy": "Treehole wants to confirm it’s you. Send a code to the phone on your account; allow reading that SMS and the code fills in by itself, or type it.",
      "sendSms": "Send SMS code",
      "smsCode": "SMS code",
      "codePlaceholder": "6 digits",
      "verify": "Verify",
      "sent": "Code sent to the phone on your account",
      "stillValid": "Your previous code is still valid; enter it here"
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "children": [
          "search",
          "results",
          "verify"
        ]
      },
      "search": {
        "type": "TextField",
        "props": {
          "label": null,
          "placeholder": {
            "$state": "/t/searchHint"
          },
          "value": {
            "$bindState": "/form/q"
          },
          "keyboard": "default",
          "returnKey": "search"
        },
        "on": {
          "submit": {
            "action": "navigate",
            "params": {
              "href": {
                "$template": "/p/treehole/search?q=${/form/q}"
              }
            }
          }
        }
      },
      "results": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/res/status",
          "eq": "ok"
        },
        "children": [
          "resList",
          "resMore",
          "resEnd",
          "resFailed",
          "resEmpty"
        ]
      },
      "resEmpty": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/noResults"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/res/holes/0",
          "not": true
        }
      },
      "hole": {
        "type": "Post",
        "props": {
          "text": {
            "$item": "text"
          },
          "meta": {
            "$template": "#${pid} · ${time}"
          },
          "replies": {
            "$item": "replies"
          },
          "likes": {
            "$item": "likes"
          },
          "tags": {
            "$item": "tags"
          },
          "lines": 8,
          "pinned": {
            "$item": "pinned"
          },
          "followed": {
            "$item": "followed"
          },
          "preview": {
            "$item": "comments"
          }
        },
        "children": [
          "holePics"
        ],
        "on": {
          "press": {
            "action": "navigate",
            "params": {
              "href": {
                "$template": "/p/treehole/hole?pid=${pid}"
              }
            }
          }
        }
      },
      "holePics": {
        "type": "Gallery",
        "props": {
          "tool": "treehole.image",
          "items": {
            "$item": "pics"
          }
        }
      },
      "resList": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "repeat": {
          "statePath": "/res/holes",
          "key": "pid"
        },
        "children": [
          "hole"
        ]
      },
      "resMore": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "repeat": {
          "statePath": "/more/res",
          "key": "pid"
        },
        "children": [
          "hole"
        ]
      },
      "resEnd": {
        "type": "EndReached",
        "props": {
          "done": {
            "$state": "/moreStatus/res/done"
          },
          "doneLabel": {
            "$state": "/t/noMore"
          }
        },
        "visible": [
          {
            "$state": "/res/holes/0"
          },
          {
            "$state": "/moreStatus/res/error",
            "not": true
          }
        ],
        "on": {
          "reach": {
            "action": "loadMore",
            "params": {
              "tool": "treehole.search",
              "input": {
                "keyword": {
                  "$state": "/params/q"
                },
                "limit": 20
              },
              "listPath": "/more/res",
              "itemsKey": "holes",
              "statusPath": "/moreStatus/res",
              "key": "pid",
              "basePath": "/res/holes"
            }
          }
        }
      },
      "resFailed": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "between"
        },
        "visible": {
          "$state": "/moreStatus/res/error"
        },
        "children": [
          "resFailedText",
          "resRetry"
        ]
      },
      "resFailedText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/loadFailed"
          },
          "tone": "muted",
          "size": "small"
        }
      },
      "resRetry": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/retry"
          },
          "variant": "ghost"
        },
        "on": {
          "press": {
            "action": "loadMore",
            "params": {
              "tool": "treehole.search",
              "input": {
                "keyword": {
                  "$state": "/params/q"
                },
                "limit": 20
              },
              "listPath": "/more/res",
              "itemsKey": "holes",
              "statusPath": "/moreStatus/res",
              "key": "pid",
              "basePath": "/res/holes"
            }
          }
        }
      },
      "verify": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/res/status",
          "eq": "verification_required"
        },
        "children": [
          "verifyTitle",
          "verifyWhy",
          "send",
          "code",
          "check",
          "sent",
          "stillValid",
          "error"
        ]
      },
      "verifyTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/t/smsNeeded"
          },
          "size": "md"
        }
      },
      "verifyWhy": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/verifyWhy"
          },
          "tone": "muted",
          "size": "body"
        }
      },
      "send": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/sendSms"
          },
          "variant": "secondary"
        },
        "on": {
          "press": [
            {
              "action": "callTool",
              "params": {
                "tool": "treehole.sendCode",
                "input": {},
                "resultPath": "/result/send",
                "errorPath": "/error"
              }
            },
            {
              "action": "smsCode",
              "params": {
                "statePath": "/form/code"
              }
            }
          ]
        }
      },
      "code": {
        "type": "TextField",
        "props": {
          "label": {
            "$state": "/t/smsCode"
          },
          "placeholder": {
            "$state": "/t/codePlaceholder"
          },
          "value": {
            "$bindState": "/form/code"
          },
          "keyboard": "number"
        }
      },
      "check": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/verify"
          },
          "variant": "primary"
        },
        "visible": {
          "$state": "/form/code"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "treehole.search",
              "input": {
                "keyword": {
                  "$state": "/params/q"
                },
                "limit": 20,
                "code": {
                  "$state": "/form/code"
                }
              },
              "errorPath": "/error"
            }
          }
        }
      },
      "sent": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/sent"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/send/sent"
          },
          {
            "$state": "/result/send/sent",
            "eq": "验证码已发送到绑定手机"
          },
          {
            "$state": "/error",
            "not": true
          }
        ]
      },
      "stillValid": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/stillValid"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/send/sent"
          },
          {
            "$state": "/result/send/sent",
            "neq": "验证码已发送到绑定手机"
          },
          {
            "$state": "/error",
            "not": true
          }
        ]
      },
      "error": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/error"
          },
          "tone": "down",
          "size": "small"
        },
        "visible": {
          "$state": "/error"
        }
      }
    },
    "state": {
      "res": null,
      "form": {
        "code": "",
        "q": ""
      },
      "result": null,
      "error": null
    }
  }
}
