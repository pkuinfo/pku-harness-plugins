{
  "title": "树洞 #{pid}",
  "description": "一个树洞帖子：全文、图片、评论（一直往下滑就继续加载，不同的人不同颜色，洞主突出），可以回复（点一条评论就是回复它）和关注。打开方式：/p/treehole/hole?pid=…",
  "feed": true,
  "bindings": {
    "/hole": {
      "tool": "read",
      "args": {
        "pid": {
          "$param": "pid"
        },
        "commentLimit": 20
      },
      "ttlMinutes": 2
    }
  },
  "strings": {
    "zh-Hans": {
      "follow": "关注",
      "following": "已关注 · 取消关注",
      "replyHint": "友善发言，匿名回复",
      "send": "发送",
      "replyingTo": "回复 ",
      "cancel": "取消",
      "sentReply": "已回复",
      "noMoreReplies": "没有更多回复了",
      "noReplies": "还没有回复",
      "loadFailed": "加载失败",
      "retry": "重试",
      "smsNeeded": "需要短信验证",
      "verifyWhy": "树洞需要确认是你本人。点下面的按钮把验证码发到账号绑定的手机，允许读取这条短信后会自动填好；也可以手动输入。",
      "sendSms": "发送短信验证码",
      "smsCode": "短信验证码",
      "codePlaceholder": "6 位数字",
      "verify": "验证",
      "sent": "验证码已发送到绑定手机",
      "stillValid": "之前的验证码还有效，可以直接输入"
    },
    "en": {
      "follow": "Follow",
      "following": "Following · Unfollow",
      "replyHint": "Reply anonymously, be kind",
      "send": "Send",
      "replyingTo": "Replying to ",
      "cancel": "Cancel",
      "sentReply": "Replied",
      "noMoreReplies": "No more replies",
      "noReplies": "No replies yet",
      "loadFailed": "Couldn’t load more",
      "retry": "Retry",
      "smsNeeded": "SMS verification needed",
      "verifyWhy": "Treehole wants to confirm it’s you. Send a code to the phone on your account; allow reading that SMS and the code fills in by itself, or type it.",
      "sendSms": "Send SMS code",
      "smsCode": "SMS code",
      "codePlaceholder": "6 digits",
      "verify": "Verify",
      "sent": "Code sent to the phone on your account",
      "stillValid": "Your previous code is still valid; enter it here"
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "children": [
          "thread",
          "verify"
        ]
      },
      "thread": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/hole/status",
          "eq": "ok"
        },
        "children": [
          "post",
          "followRow",
          "composer",
          "commentList",
          "commentMore",
          "commentEnd",
          "commentFailed",
          "noReplies"
        ]
      },
      "post": {
        "type": "Post",
        "props": {
          "text": {
            "$state": "/hole/hole/text"
          },
          "meta": {
            "$template": "#${/hole/hole/pid} · ${/hole/hole/time}"
          },
          "replies": {
            "$state": "/hole/totalComments"
          },
          "likes": {
            "$state": "/hole/hole/likes"
          },
          "tags": {
            "$state": "/hole/hole/tags"
          },
          "pinned": {
            "$state": "/hole/hole/pinned"
          },
          "followed": {
            "$state": "/hole/hole/followed"
          }
        },
        "children": [
          "postPics"
        ]
      },
      "postPics": {
        "type": "Gallery",
        "props": {
          "tool": "treehole.image",
          "items": {
            "$state": "/hole/hole/pics"
          }
        }
      },
      "followRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "follow",
          "unfollow"
        ]
      },
      "follow": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/follow"
          },
          "variant": "secondary"
        },
        "visible": {
          "$state": "/hole/hole/followed",
          "not": true
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "treehole.follow",
              "input": {
                "pid": {
                  "$state": "/hole/hole/pid"
                }
              },
              "resultPath": "/result/follow",
              "errorPath": "/error"
            }
          }
        }
      },
      "unfollow": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/following"
          },
          "variant": "ghost"
        },
        "visible": {
          "$state": "/hole/hole/followed"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "treehole.unfollow",
              "input": {
                "pid": {
                  "$state": "/hole/hole/pid"
                }
              },
              "resultPath": "/result/follow",
              "errorPath": "/error"
            }
          }
        }
      },
      "composer": {
        "type": "Column",
        "props": {
          "gap": "sm"
        },
        "children": [
          "quoting",
          "replyField",
          "sendReply",
          "replySent",
          "error"
        ]
      },
      "quoting": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "between"
        },
        "visible": {
          "$state": "/form/quoteName"
        },
        "children": [
          "quotingText",
          "quotingCancel"
        ]
      },
      "quotingText": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/t/replyingTo}${/form/quoteName}"
          },
          "tone": "accent",
          "size": "small"
        }
      },
      "quotingCancel": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/cancel"
          },
          "variant": "ghost"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/form/quoteCid",
                "value": null
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/form/quoteName",
                "value": null
              }
            }
          ]
        }
      },
      "replyField": {
        "type": "TextField",
        "props": {
          "label": null,
          "placeholder": {
            "$state": "/t/replyHint"
          },
          "value": {
            "$bindState": "/form/reply"
          },
          "keyboard": "default",
          "multiline": true
        }
      },
      "sendReply": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/send"
          },
          "variant": "primary"
        },
        "visible": {
          "$state": "/form/reply"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "treehole.reply",
              "input": {
                "pid": {
                  "$state": "/hole/hole/pid"
                },
                "text": {
                  "$state": "/form/reply"
                },
                "quoteCid": {
                  "$state": "/form/quoteCid"
                }
              },
              "resultPath": "/result/reply",
              "errorPath": "/error",
              "clear": [
                "/form/reply",
                "/form/quoteCid",
                "/form/quoteName"
              ]
            }
          }
        }
      },
      "replySent": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/sentReply"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/reply/status",
            "eq": "posted"
          },
          {
            "$state": "/form/reply",
            "not": true
          }
        ]
      },
      "comment": {
        "type": "Comment",
        "props": {
          "author": {
            "$item": "name"
          },
          "text": {
            "$item": "text"
          },
          "time": {
            "$item": "time"
          },
          "op": {
            "$item": "op"
          },
          "quote": {
            "$item": "replyTo"
          }
        },
        "children": [
          "commentPics"
        ],
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/form/quoteCid",
                "value": {
                  "$item": "cid"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/form/quoteName",
                "value": {
                  "$item": "name"
                }
              }
            }
          ]
        }
      },
      "commentPics": {
        "type": "Gallery",
        "props": {
          "tool": "treehole.image",
          "items": {
            "$item": "pics"
          },
          "compact": true
        }
      },
      "commentList": {
        "type": "Column",
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/hole/comments",
          "key": "cid"
        },
        "children": [
          "comment"
        ]
      },
      "commentMore": {
        "type": "Column",
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/more/comments",
          "key": "cid"
        },
        "children": [
          "comment"
        ]
      },
      "commentEnd": {
        "type": "EndReached",
        "props": {
          "done": {
            "$state": "/moreStatus/comments/done"
          },
          "doneLabel": {
            "$state": "/t/noMoreReplies"
          }
        },
        "visible": [
          {
            "$state": "/hole/comments/0"
          },
          {
            "$state": "/moreStatus/comments/error",
            "not": true
          }
        ],
        "on": {
          "reach": {
            "action": "loadMore",
            "params": {
              "tool": "treehole.comments",
              "input": {
                "pid": {
                  "$state": "/hole/hole/pid"
                },
                "limit": 20
              },
              "listPath": "/more/comments",
              "itemsKey": "comments",
              "statusPath": "/moreStatus/comments",
              "key": "cid",
              "basePath": "/hole/comments"
            }
          }
        }
      },
      "commentFailed": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "between"
        },
        "visible": {
          "$state": "/moreStatus/comments/error"
        },
        "children": [
          "commentFailedText",
          "commentRetry"
        ]
      },
      "commentFailedText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/loadFailed"
          },
          "tone": "muted",
          "size": "small"
        }
      },
      "commentRetry": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/retry"
          },
          "variant": "ghost"
        },
        "on": {
          "press": {
            "action": "loadMore",
            "params": {
              "tool": "treehole.comments",
              "input": {
                "pid": {
                  "$state": "/hole/hole/pid"
                },
                "limit": 20
              },
              "listPath": "/more/comments",
              "itemsKey": "comments",
              "statusPath": "/moreStatus/comments",
              "key": "cid",
              "basePath": "/hole/comments"
            }
          }
        }
      },
      "noReplies": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/noReplies"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/hole/comments/0",
          "not": true
        }
      },
      "verify": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/hole/status",
          "eq": "verification_required"
        },
        "children": [
          "verifyTitle",
          "verifyWhy",
          "send",
          "code",
          "check",
          "sent",
          "stillValid",
          "error"
        ]
      },
      "verifyTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/t/smsNeeded"
          },
          "size": "md"
        }
      },
      "verifyWhy": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/verifyWhy"
          },
          "tone": "muted",
          "size": "body"
        }
      },
      "send": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/sendSms"
          },
          "variant": "secondary"
        },
        "on": {
          "press": [
            {
              "action": "callTool",
              "params": {
                "tool": "treehole.sendCode",
                "input": {},
                "resultPath": "/result/send",
                "errorPath": "/error"
              }
            },
            {
              "action": "smsCode",
              "params": {
                "statePath": "/form/code"
              }
            }
          ]
        }
      },
      "code": {
        "type": "TextField",
        "props": {
          "label": {
            "$state": "/t/smsCode"
          },
          "placeholder": {
            "$state": "/t/codePlaceholder"
          },
          "value": {
            "$bindState": "/form/code"
          },
          "keyboard": "number"
        }
      },
      "check": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/verify"
          },
          "variant": "primary"
        },
        "visible": {
          "$state": "/form/code"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "treehole.read",
              "input": {
                "pid": {
                  "$state": "/params/pid"
                },
                "commentLimit": 20,
                "code": {
                  "$state": "/form/code"
                }
              },
              "errorPath": "/error"
            }
          }
        }
      },
      "sent": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/sent"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/send/sent"
          },
          {
            "$state": "/result/send/sent",
            "eq": "验证码已发送到绑定手机"
          },
          {
            "$state": "/error",
            "not": true
          }
        ]
      },
      "stillValid": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/stillValid"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/send/sent"
          },
          {
            "$state": "/result/send/sent",
            "neq": "验证码已发送到绑定手机"
          },
          {
            "$state": "/error",
            "not": true
          }
        ]
      },
      "error": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/error"
          },
          "tone": "down",
          "size": "small"
        },
        "visible": {
          "$state": "/error"
        }
      }
    },
    "state": {
      "hole": null,
      "form": {
        "code": "",
        "reply": "",
        "quoteCid": null,
        "quoteName": null
      },
      "result": null,
      "error": null
    }
  }
}
