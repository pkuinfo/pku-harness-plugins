{
  "title": "邮件",
  "description": "一封邮件：发件人、收件人、时间、正文、附件名，下面可以回复或回复全部。打开时标为已读。打开方式：/p/mail/message?mid=…",
  "bindings": {
    "/msg": {
      "tool": "read",
      "args": {
        "mid": {
          "$param": "mid"
        },
        "markRead": true
      },
      "ttlMinutes": 10
    }
  },
  "strings": {
    "zh-Hans": {
      "from": "发件人：",
      "to": "收件人：",
      "cc": "抄送：",
      "attachments": "附件",
      "attachmentsNote": "附件暂时只能在网页版邮箱下载",
      "replyHint": "写回复…",
      "reply": "回复",
      "replyAll": "回复全部",
      "sent": "已发送",
      "truncated": "正文太长，只显示了前面一部分"
    },
    "en": {
      "from": "From: ",
      "to": "To: ",
      "cc": "Cc: ",
      "attachments": "Attachments",
      "attachmentsNote": "For now attachments can only be downloaded in web mail",
      "replyHint": "Write a reply…",
      "reply": "Reply",
      "replyAll": "Reply all",
      "sent": "Sent",
      "truncated": "This message is long; only the beginning is shown"
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Column",
        "props": {
          "gap": "md"
        },
        "children": [
          "subject",
          "fromLine",
          "toLine",
          "ccLine",
          "date",
          "divider",
          "body",
          "truncated",
          "attTitle",
          "attList",
          "attNote",
          "divider2",
          "replyField",
          "replyRow",
          "replySent",
          "error"
        ]
      },
      "subject": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/msg/subject"
          },
          "size": "md"
        }
      },
      "fromLine": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/t/from}${/msg/from} <${/msg/fromEmail}>"
          },
          "tone": "default",
          "size": "small"
        }
      },
      "toLine": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/t/to}${/msg/toLine}"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/msg/toLine"
        }
      },
      "ccLine": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/t/cc}${/msg/ccLine}"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/msg/ccLine"
        }
      },
      "date": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/msg/date"
          },
          "tone": "muted",
          "size": "small"
        }
      },
      "divider": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/msg/text"
          },
          "tone": "default",
          "size": "body"
        }
      },
      "truncated": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/truncated"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/msg/truncated"
        }
      },
      "attTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/t/attachments"
          },
          "size": "sm"
        },
        "visible": {
          "$state": "/msg/attachments/0"
        }
      },
      "attList": {
        "type": "Column",
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/msg/attachments",
          "key": "part"
        },
        "children": [
          "att"
        ]
      },
      "att": {
        "type": "ListItem",
        "props": {
          "title": {
            "$item": "name"
          },
          "subtitle": null,
          "value": {
            "$item": "sizeText"
          },
          "icon": null
        }
      },
      "attNote": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/attachmentsNote"
          },
          "tone": "muted",
          "size": "small"
        },
        "visible": {
          "$state": "/msg/attachments/0"
        }
      },
      "divider2": {
        "type": "Divider",
        "props": {}
      },
      "replyField": {
        "type": "TextField",
        "props": {
          "label": null,
          "placeholder": {
            "$state": "/t/replyHint"
          },
          "value": {
            "$bindState": "/form/reply"
          },
          "keyboard": "default",
          "multiline": true
        }
      },
      "replyRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "replyBtn",
          "replyAllBtn"
        ]
      },
      "replyBtn": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/reply"
          },
          "variant": "primary"
        },
        "visible": {
          "$state": "/form/reply"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "mail.reply",
              "input": {
                "mid": {
                  "$state": "/params/mid"
                },
                "body": {
                  "$state": "/form/reply"
                },
                "all": false
              },
              "resultPath": "/result/reply",
              "errorPath": "/error",
              "clear": [
                "/form/reply"
              ]
            }
          }
        }
      },
      "replyAllBtn": {
        "type": "Button",
        "props": {
          "label": {
            "$state": "/t/replyAll"
          },
          "variant": "secondary"
        },
        "visible": {
          "$state": "/form/reply"
        },
        "on": {
          "press": {
            "action": "callTool",
            "params": {
              "tool": "mail.reply",
              "input": {
                "mid": {
                  "$state": "/params/mid"
                },
                "body": {
                  "$state": "/form/reply"
                },
                "all": true
              },
              "resultPath": "/result/reply",
              "errorPath": "/error",
              "clear": [
                "/form/reply"
              ]
            }
          }
        }
      },
      "replySent": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/sent"
          },
          "tone": "up",
          "size": "small"
        },
        "visible": [
          {
            "$state": "/result/reply/status",
            "eq": "sent"
          },
          {
            "$state": "/form/reply",
            "not": true
          }
        ]
      },
      "error": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/error"
          },
          "tone": "down",
          "size": "small"
        },
        "visible": {
          "$state": "/error"
        }
      }
    },
    "state": {
      "msg": null,
      "form": {
        "reply": ""
      },
      "result": null,
      "error": null
    }
  }
}
