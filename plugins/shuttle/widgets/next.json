{
  "title": "下一班校车",
  "description": "燕园⇄新燕园通勤班车两个方向的下一班（倒计时），按内置时刻表每分钟刷新，无需联网。",
  "sizes": ["sm", "md", "lg"],
  "defaultSize": "md",
  "bindings": {
    "/next": { "tool": "next", "args": { "count": 2 }, "ttlMinutes": 1 }
  },
  "strings": {
    "zh-Hans": {
      "toX": "燕园 → 新燕园", "toY": "新燕园 → 燕园", "soon": "即将发车", "inBefore": "", "inAfter": " 分钟后", "none": "今明两天没有班次",
      "footnote": "需在门户「新校区班车预约」预约 · 节假日按周末表",
      "askX": "燕园到新燕园的下一班校车", "askY": "新燕园到燕园的下一班校车",
      "sun": "周日", "mon": "周一", "tue": "周二", "wed": "周三", "thu": "周四", "fri": "周五", "sat": "周六"
    },
    "en": {
      "toX": "Yanyuan → Xinyanyuan", "toY": "Xinyanyuan → Yanyuan", "soon": "Leaving now", "inBefore": "in ", "inAfter": " min", "none": "No runs today or tomorrow",
      "footnote": "Book first on the portal (新校区班车预约) · holidays run the weekend timetable",
      "askX": "Next shuttle from Yanyuan to Xinyanyuan", "askY": "Next shuttle from Xinyanyuan to Yanyuan",
      "sun": "Sun", "mon": "Mon", "tue": "Tue", "wed": "Wed", "thu": "Thu", "fri": "Fri", "sat": "Sat"
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": { "type": "Column", "props": { "gap": "md" }, "children": ["toX", "toY", "footnote"] },

      "toX": { "type": "Column", "props": { "gap": "sm" }, "children": ["toXLabel", "toXList", "toXNone"] },
      "toXLabel": { "type": "Text", "props": { "text": { "$state": "/t/toX" }, "tone": "muted", "size": "small" } },
      "toXList": {
        "type": "Column",
        "props": { "gap": "sm" },
        "repeat": { "statePath": "/next/directions/0/departures", "key": "inMinutes" },
        "children": ["toXRun"]
      },
      "toXRun": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "time" },
          "subtitle": null,
          "value": {
            "$cond": { "$item": "inMinutes", "lt": 1 },
            "$then": { "$state": "/t/soon" },
            "$else": {
              "$cond": { "$item": "inMinutes", "lt": 180 },
              "$then": { "$template": "${/t/inBefore}${inMinutes}${/t/inAfter}" },
              "$else": {
                "$cond": { "$item": "weekday", "eq": "周日" }, "$then": { "$state": "/t/sun" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周一" }, "$then": { "$state": "/t/mon" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周二" }, "$then": { "$state": "/t/tue" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周三" }, "$then": { "$state": "/t/wed" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周四" }, "$then": { "$state": "/t/thu" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周五" }, "$then": { "$state": "/t/fri" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周六" }, "$then": { "$state": "/t/sat" }, "$else": { "$item": "weekday" }
                } } } } } }
              }
            }
          },
          "icon": "clock"
        },
        "on": { "press": { "action": "ask", "params": { "text": { "$state": "/t/askX" } } } }
      },
      "toXNone": {
        "type": "Text",
        "props": { "text": { "$state": "/t/none" }, "tone": "muted", "size": "small" },
        "visible": [{ "$state": "/next" }, { "$state": "/next/directions/0/departures/0", "not": true }]
      },

      "toY": { "type": "Column", "props": { "gap": "sm" }, "children": ["toYLabel", "toYList", "toYNone"] },
      "toYLabel": { "type": "Text", "props": { "text": { "$state": "/t/toY" }, "tone": "muted", "size": "small" } },
      "toYList": {
        "type": "Column",
        "props": { "gap": "sm" },
        "repeat": { "statePath": "/next/directions/1/departures", "key": "inMinutes" },
        "children": ["toYRun"]
      },
      "toYRun": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "time" },
          "subtitle": null,
          "value": {
            "$cond": { "$item": "inMinutes", "lt": 1 },
            "$then": { "$state": "/t/soon" },
            "$else": {
              "$cond": { "$item": "inMinutes", "lt": 180 },
              "$then": { "$template": "${/t/inBefore}${inMinutes}${/t/inAfter}" },
              "$else": {
                "$cond": { "$item": "weekday", "eq": "周日" }, "$then": { "$state": "/t/sun" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周一" }, "$then": { "$state": "/t/mon" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周二" }, "$then": { "$state": "/t/tue" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周三" }, "$then": { "$state": "/t/wed" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周四" }, "$then": { "$state": "/t/thu" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周五" }, "$then": { "$state": "/t/fri" }, "$else": {
                "$cond": { "$item": "weekday", "eq": "周六" }, "$then": { "$state": "/t/sat" }, "$else": { "$item": "weekday" }
                } } } } } }
              }
            }
          },
          "icon": "clock"
        },
        "on": { "press": { "action": "ask", "params": { "text": { "$state": "/t/askY" } } } }
      },
      "toYNone": {
        "type": "Text",
        "props": { "text": { "$state": "/t/none" }, "tone": "muted", "size": "small" },
        "visible": [{ "$state": "/next" }, { "$state": "/next/directions/1/departures/0", "not": true }]
      },

      "footnote": { "type": "Text", "props": { "text": { "$state": "/t/footnote" }, "tone": "muted", "size": "small" } }
    },
    "state": { "next": null }
  }
}
