{
  "title": "浴卡充值",
  "description": "浴卡充值：选金额，在收费平台「我的订单」里用微信或支付宝付款。",
  "presentation": "modal",
  "strings": {
    "zh-Hans": {
      "otherAmount": "其他金额（元）",
      "amountHint": "10–100",
      "rechargeAmount": "充值 ¥",
      "rechargeNote": "在学校收费平台里用微信或支付宝付款，本 App 不经手钱款。线上充值后要拿浴卡到浴卡转存机贴卡激活，钱才写进卡里。浴卡余额线上查不到。",
      "opened": "已在浏览器打开收费平台：到「我的订单」里付这笔待支付订单。付完拿浴卡到转存机上贴一下才到账。"
    },
    "en": {
      "otherAmount": "Other amount (¥)",
      "amountHint": "10–100",
      "rechargeAmount": "Top up ¥",
      "rechargeNote": "You pay with WeChat or Alipay on the university’s payment platform; this app never handles the money. After topping up online, tap your bath card on a top-up kiosk to load the credit onto it. The balance can’t be checked online.",
      "opened": "The payment platform is open in your browser: pay the unpaid order under My orders (我的订单). Then tap your bath card on a top-up kiosk to load the credit."
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Column",
        "props": {
          "gap": "lg"
        },
        "children": [
          "presets",
          "custom",
          "note",
          "go",
          "opened",
          "error"
        ]
      },
      "presets": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "wrap": true
        },
        "children": [
          "p20",
          "p50",
          "p100"
        ]
      },
      "custom": {
        "type": "TextField",
        "props": {
          "label": {
            "$state": "/t/otherAmount"
          },
          "placeholder": {
            "$state": "/t/amountHint"
          },
          "value": {
            "$bindState": "/form/custom"
          },
          "keyboard": "number"
        }
      },
      "note": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/rechargeNote"
          },
          "tone": "muted",
          "size": "small"
        }
      },
      "go": {
        "type": "Button",
        "props": {
          "label": {
            "$cond": {
              "$state": "/form/custom"
            },
            "$then": {
              "$template": "${/t/rechargeAmount}${/form/custom}"
            },
            "$else": {
              "$template": "${/t/rechargeAmount}${/form/preset}"
            }
          },
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/result/topUp",
                "value": null
              }
            },
            {
              "action": "callTool",
              "params": {
                "tool": "wallet.bathTopUp",
                "input": {
                  "preset": {
                    "$state": "/form/preset"
                  },
                  "custom": {
                    "$state": "/form/custom"
                  }
                },
                "resultPath": "/result/topUp",
                "errorPath": "/error"
              }
            }
          ]
        }
      },
      "opened": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/t/opened"
          },
          "tone": "up",
          "size": "body"
        },
        "visible": {
          "$state": "/result/topUp"
        }
      },
      "error": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/error"
          },
          "tone": "down",
          "size": "body"
        },
        "visible": {
          "$state": "/error"
        }
      },
      "p20": {
        "type": "Button",
        "props": {
          "label": "¥20",
          "variant": {
            "$cond": [
              {
                "$state": "/form/custom",
                "not": true
              },
              {
                "$state": "/form/preset",
                "eq": 20
              }
            ],
            "$then": "primary",
            "$else": "secondary"
          }
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/form/custom",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/form/preset",
                "value": 20
              }
            }
          ]
        }
      },
      "p50": {
        "type": "Button",
        "props": {
          "label": "¥50",
          "variant": {
            "$cond": [
              {
                "$state": "/form/custom",
                "not": true
              },
              {
                "$state": "/form/preset",
                "eq": 50
              }
            ],
            "$then": "primary",
            "$else": "secondary"
          }
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/form/custom",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/form/preset",
                "value": 50
              }
            }
          ]
        }
      },
      "p100": {
        "type": "Button",
        "props": {
          "label": "¥100",
          "variant": {
            "$cond": [
              {
                "$state": "/form/custom",
                "not": true
              },
              {
                "$state": "/form/preset",
                "eq": 100
              }
            ],
            "$then": "primary",
            "$else": "secondary"
          }
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/form/custom",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/form/preset",
                "value": 100
              }
            }
          ]
        }
      }
    },
    "state": {
      "form": {
        "preset": 50,
        "custom": ""
      },
      "result": {
        "topUp": null
      },
      "error": null
    }
  }
}