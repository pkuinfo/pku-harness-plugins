{
  "title": "浴卡",
  "description": "浴卡最近一次充值（金额、时间、状态）和充值入口。浴卡余额在卡片芯片里，线上查不到。",
  "sizes": ["sm", "md"],
  "defaultSize": "sm",
  "bindings": {
    "/bath": { "tool": "bathCard", "ttlMinutes": 30 }
  },
  "strings": {
    "zh-Hans": {
      "signedOut": "登录校园账号后显示浴卡",
      "signIn": "登录",
      "label": "浴卡 · 最近充值",
      "lastTopUp": "最近充值",
      "noTopUps": "还没有线上充值记录",
      "closed": "收费平台目前没有为你的账号开放浴卡充值。浴卡余额在卡片芯片里，可在转存机或洗浴时查看。",
      "activate": " · 余额在卡里，需转存机激活",
      "topUp": "充值",
      "待支付": "待支付",
      "已付款": "已付款",
      "未知": "未知"
    },
    "en": {
      "signedOut": "Sign in to your campus account to see your bath card",
      "signIn": "Sign in",
      "label": "Bath card · Latest top-up",
      "lastTopUp": "Latest top-up",
      "noTopUps": "No online top-ups yet",
      "closed": "The payment platform doesn’t offer bath-card top-ups for your account right now. The balance lives on the card chip: check it at a top-up kiosk or in the shower.",
      "activate": " · Credit goes on the card at a top-up kiosk",
      "topUp": "Top up",
      "待支付": "Unpaid",
      "已付款": "Paid",
      "未知": "Unknown"
    }
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": { "type": "Column", "props": { "gap": "sm" }, "children": ["signedOut", "closed", "live"] },
      "signedOut": {
        "type": "Column",
        "props": { "gap": "sm" },
        "visible": { "$state": "/account/signedIn", "not": true },
        "children": ["signedOutText", "signIn"]
      },
      "signedOutText": { "type": "Text", "props": { "text": { "$state": "/t/signedOut" }, "tone": "muted", "size": "small" } },
      "signIn": {
        "type": "Button",
        "props": { "label": { "$state": "/t/signIn" }, "variant": "secondary" },
        "on": { "press": { "action": "navigate", "params": { "href": "/campus" } } }
      },
      "closed": {
        "type": "Text",
        "props": { "text": { "$state": "/t/closed" }, "tone": "muted", "size": "small" },
        "visible": [{ "$state": "/account/signedIn" }, { "$state": "/bath/available", "eq": false }]
      },
      "live": {
        "type": "Column",
        "props": { "gap": "sm" },
        "visible": [{ "$state": "/account/signedIn" }, { "$state": "/bath/available", "neq": false }],
        "children": ["lastList", "none", "topUp"]
      },
      "lastList": { "type": "Column", "props": { "gap": "sm" }, "repeat": { "statePath": "/bath/recentTopUps" }, "children": ["last"] },
      "last": {
        "type": "Column",
        "props": { "gap": "sm" },
        "visible": { "$index": true, "lt": 1 },
        "children": ["lastAmount", "lastStatus", "lastWhen"]
      },
      "lastAmount": {
        "type": "Stat",
        "props": {
          "label": { "$cond": { "$state": "/size", "eq": "sm" }, "$then": { "$state": "/t/label" }, "$else": { "$state": "/t/lastTopUp" } },
          "value": { "$item": "amount" },
          "prefix": "¥",
          "suffix": null,
          "decimals": 2,
          "delta": null,
          "deltaTone": null,
          "caption": null,
          "icon": null,
          "size": "lg"
        },
        "visible": { "$item": "amount", "neq": null }
      },
      "lastStatus": {
        "type": "Badge",
        "props": {
          "label": {
            "$cond": { "$item": "status", "eq": "待支付" },
            "$then": { "$state": "/t/待支付" },
            "$else": { "$cond": { "$item": "status", "eq": "已付款" }, "$then": { "$state": "/t/已付款" }, "$else": { "$item": "status" } }
          },
          "tone": { "$cond": { "$item": "status", "eq": "待支付" }, "$then": "warn", "$else": "neutral" }
        }
      },
      "lastWhen": {
        "type": "Text",
        "props": { "text": { "$template": "${createdAt}${/t/activate}" }, "tone": "muted", "size": "small" },
        "visible": { "$state": "/size", "neq": "sm" }
      },
      "none": { "type": "Text", "props": { "text": { "$state": "/t/noTopUps" }, "tone": "muted", "size": "body" }, "visible": { "$state": "/bath/recentTopUps/0", "not": true } },
      "topUp": {
        "type": "Button",
        "props": { "label": { "$state": "/t/topUp" }, "variant": "secondary" },
        "on": { "press": { "action": "navigate", "params": { "href": "/m/wallet/bath-recharge" } } }
      }
    },
    "state": { "bath": null }
  }
}
