{
  "name": "pku-harness-plugins",
  "private": true,
  "description": "Plugins for PKU Harness — built-in and community, all equal. Plus the SDK and the marketplace registry.",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "examples/*",
    "templates/*"
  ],
  "scripts": {
    "check": "tsc --noEmit -p . && bun scripts/validate-registry.ts && bun scripts/bundle-docs.ts --check",
    "test": "bun test",
    "validate": "bun scripts/validate-registry.ts",
    "plugin": "bun scripts/plugin.ts",
    "bundle": "bun scripts/bundle-docs.ts",
    "verify": "bun run check && bun test"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@types/bun": "^1.3.0",
    "@types/react": "~19.3.0",
    "node-html-parser": "^9.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
