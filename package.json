    "validate": "bun scripts/validate-registry.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@types/bun": "^1.3.0",
    "@types/react": "~19.3.0",
    "node-html-parser": "^9.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  }
}
